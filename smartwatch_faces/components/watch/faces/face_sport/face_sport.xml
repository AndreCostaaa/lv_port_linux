<component>
	<!-- Sport face: huge digits, a seconds arc sweeping the edge and a
	     2x2 grid of complications. -->
	<styles>
		<style name="style_digits" text_font="font_watch_digits_lg" />
		<style name="style_ticks_main" arc_opa="0%" />
		<style name="style_ticks_minor" length="6" line_width="2" line_color="#color_surface_hi" />
		<style name="style_ticks_major" length="14" line_width="3" line_color="#color_text_muted" />
	</styles>

	<view extends="box" scrollable="false">
		<style name="style_face" />

		<!-- Minute ticks inside the seconds arc -->
		<lv_scale
			width="436"
			height="436"
			align="center"
			mode="round_inner"
			total_tick_count="60"
			major_tick_every="5"
			min_value="0"
			max_value="59"
			angle_range="354"
			rotation="270"
			label_show="false"
			clickable="false"
		>
			<style name="style_ticks_main" />
			<style name="style_ticks_minor" selector="items" />
			<style name="style_ticks_major" selector="indicator" />
		</lv_scale>

		<!-- Seconds arc (accent) -->
		<ring size="462" thickness="8" subject="subject_second" max="59">
			<bind_flag_if_eq subject="subject_show_seconds" flag="hidden" ref_value="0" />
		</ring>

		<!-- Date -->
		<row align="top_mid" y="72" gap="8">
			<bind_flag_if_eq subject="subject_show_date" flag="hidden" ref_value="0" />
			<accent_label bind_text="subject_weekday" style_text_font="font_watch_body" />
			<lv_label bind_text="subject_day" bind_text-fmt="%d" style_text_font="font_watch_body" />
			<lv_label bind_text="subject_month" style_text_font="font_watch_body" style_text_color="#color_text_muted" />
		</row>

		<!-- Time -->
		<row align="center" y="-44" vertical_align="center">
			<lv_label bind_text="subject_hour" bind_text-fmt="%02d">
				<style name="style_digits" />
			</lv_label>
			<lv_label text=":" style_text_color="#color_text_muted">
				<style name="style_digits" />
			</lv_label>
			<accent_label bind_text="subject_minute" bind_text-fmt="%02d">
				<style name="style_digits" />
			</accent_label>
		</row>

		<!-- 2x2 complications -->
		<column align="center" y="104" gap="8">
			<row gap="8">
				<stat_tile icon="icon_heart_24" color="#color_heart" subject="subject_heart_rate" fmt="%d bpm" min="40" max="180" />
				<stat_tile icon="icon_footprints_24" color="#color_exercise" subject="subject_steps" fmt="%d" min="0" max="10000" />
			</row>
			<row gap="8">
				<stat_tile icon="icon_thermometer_24" color="#color_weather" subject="subject_temp" fmt="%d°C" min="-10" max="40" />
				<stat_tile icon="icon_battery_24" color="#color_stand" subject="subject_battery" fmt="%d%%" min="0" max="100" />
			</row>
		</column>
	</view>
</component>
