<component>
	<!-- Numerals: huge stacked hour and minute digits on a dark disc, the date
	     on the side and a thin seconds ring. -->
	<styles>
		<style name="style_digits" text_font="font_watch_digits_lg" text_letter_space="-4" />
		<style name="style_disc" width="400" height="400" radius="#radius_round" bg_color="0x17171B" bg_opa="100%" />
	</styles>

	<!-- Decoration only: nothing inside a face is clickable, so presses reach
	     whatever holds the face (face_stack, face_slot, ...). -->
	<view extends="box" scrollable="false" clickable="false">
		<style name="style_face" />

		<box align="center" clickable="false">
			<style name="style_disc" />
		</box>

		<!-- Seconds ring -->
		<ring size="456" thickness="5" subject="subject_second" max="59">
			<bind_flag_if_eq subject="subject_show_seconds" flag="hidden" ref_value="0" />
		</ring>

		<!-- Stacked digits -->
		<lv_label align="center" x="-26" y="-62" bind_text="subject_hour" bind_text-fmt="%02d" clickable="false">
			<style name="style_digits" />
		</lv_label>
		<accent_label align="center" x="-26" y="62" bind_text="subject_minute" bind_text-fmt="%02d">
			<style name="style_digits" />
		</accent_label>

		<!-- Date, stacked on the right -->
		<column align="center" x="130" horizontal_align="center" gap="2" clickable="false">
			<bind_flag_if_eq subject="subject_show_date" flag="hidden" ref_value="0" />
			<lv_label bind_text="subject_weekday">
				<style name="style_caption" />
			</lv_label>
			<lv_label bind_text="subject_day" bind_text-fmt="%d" style_text_font="font_watch_title" />
			<lv_label bind_text="subject_month">
				<style name="style_caption" />
			</lv_label>
		</column>
	</view>
</component>
