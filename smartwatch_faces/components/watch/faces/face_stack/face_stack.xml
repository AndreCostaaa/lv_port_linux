<component>
	<previews>
		<preview name="default" width="466" height="466" style_bg_color="0x000000" />
	</previews>

	<api>
		<prop name="subject" type="subject" default="subject_active_face" help="Int subject (0..5) selecting the visible face" />
	</api>

	<!-- All six faces stacked; only the one whose index matches $subject
	     is visible (hidden faces cost nothing to draw). Face index order:
	     0 classic, 1 activity, 2 sport, 3 minimal, 4 info, 5 chrono. -->
	<view extends="box" scrollable="false">
		<style name="style_face" />
		<face_classic align="center">
			<bind_flag_if_not_eq subject="$subject" flag="hidden" ref_value="0" />
		</face_classic>
		<face_activity align="center">
			<bind_flag_if_not_eq subject="$subject" flag="hidden" ref_value="1" />
		</face_activity>
		<face_sport align="center">
			<bind_flag_if_not_eq subject="$subject" flag="hidden" ref_value="2" />
		</face_sport>
		<face_minimal align="center">
			<bind_flag_if_not_eq subject="$subject" flag="hidden" ref_value="3" />
		</face_minimal>
		<face_info align="center">
			<bind_flag_if_not_eq subject="$subject" flag="hidden" ref_value="4" />
		</face_info>
		<face_chrono align="center">
			<bind_flag_if_not_eq subject="$subject" flag="hidden" ref_value="5" />
		</face_chrono>
	</view>
</component>
