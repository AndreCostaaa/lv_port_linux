<component>
	<!-- Radar: a green phosphor scope. Range rings, a crosshair, a few blips,
	     the seconds hand as the sweep and thin hour/minute hands. -->
	<consts>
		<color name="phosphor" value="0x2BF28A" help="Scope green" />
	</consts>

	<styles>
		<style name="style_dial" bg_color="0x041A0E" bg_grad_color="0x010803" bg_grad_dir="ver" />
		<style name="style_range_ring" radius="#radius_round" border_width="1" border_color="#phosphor" border_opa="40%" />
		<style name="style_cross" bg_color="#phosphor" bg_opa="25%" />
		<style name="style_ticks_main" arc_opa="0%" />
		<style name="style_ticks_minor" length="6" line_width="1" line_color="#phosphor" line_opa="60%" />
		<style name="style_ticks_major" length="14" line_width="2" line_color="#phosphor" />
		<style name="style_blip" radius="#radius_round" bg_color="0xB8FFD8" bg_opa="100%" />
		<style name="style_blip_halo" radius="#radius_round" bg_color="#phosphor" bg_opa="25%" />
		<style name="style_scope_text" text_font="font_watch_caption" text_color="#phosphor" text_letter_space="2" />
	</styles>

	<!-- Decoration only: nothing inside a face is clickable, so presses reach
	     whatever holds the face (face_stack, face_slot, ...). -->
	<view extends="box" scrollable="false" clickable="false">
		<style name="style_face" />
		<style name="style_dial" />

		<!-- Range rings and crosshair -->
		<box align="center" width="440" height="440" clickable="false">
			<style name="style_range_ring" />
		</box>
		<box align="center" width="330" height="330" clickable="false">
			<style name="style_range_ring" />
		</box>
		<box align="center" width="220" height="220" clickable="false">
			<style name="style_range_ring" />
		</box>
		<box align="center" width="110" height="110" clickable="false">
			<style name="style_range_ring" />
		</box>
		<box align="center" width="1" height="440" clickable="false">
			<style name="style_cross" />
		</box>
		<box align="center" width="440" height="1" clickable="false">
			<style name="style_cross" />
		</box>
		<lv_scale width="456" height="456" align="center" mode="round_inner" total_tick_count="60" major_tick_every="5" min_value="0" max_value="59" angle_range="354" rotation="270" label_show="false" clickable="false">
			<style name="style_ticks_main" />
			<style name="style_ticks_minor" selector="items" />
			<style name="style_ticks_major" selector="indicator" />
		</lv_scale>

		<!-- Contacts -->
		<box align="center" x="80" y="-60" width="30" height="30" clickable="false">
			<style name="style_blip_halo" />
		</box>
		<box align="center" x="80" y="-60" width="10" height="10" clickable="false">
			<style name="style_blip" />
		</box>
		<box align="center" x="-110" y="40" width="24" height="24" clickable="false">
			<style name="style_blip_halo" />
		</box>
		<box align="center" x="-110" y="40" width="8" height="8" clickable="false">
			<style name="style_blip" />
		</box>
		<box align="center" x="40" y="130" width="21" height="21" clickable="false">
			<style name="style_blip_halo" />
		</box>
		<box align="center" x="40" y="130" width="7" height="7" clickable="false">
			<style name="style_blip" />
		</box>
		<box align="center" x="-60" y="-140" width="18" height="18" clickable="false">
			<style name="style_blip_halo" />
		</box>
		<box align="center" x="-60" y="-140" width="6" height="6" clickable="false">
			<style name="style_blip" />
		</box>

		<!-- Readouts -->
		<lv_label text="LVGL RADAR" align="center" y="-86">
			<style name="style_scope_text" />
		</lv_label>
		<row align="center" y="86" clickable="false">
			<lv_label bind_text="subject_hour" bind_text-fmt="%02d">
				<style name="style_scope_text" />
			</lv_label>
			<lv_label text=":">
				<style name="style_scope_text" />
			</lv_label>
			<lv_label bind_text="subject_minute" bind_text-fmt="%02d">
				<style name="style_scope_text" />
			</lv_label>
		</row>

		<!-- Hands, posed at 10:09:30; the seconds hand is the sweep -->
		<hand name="hand_hour" w="4" h="120" pivot_x="2" pivot_y="110" offset="-50" angle="3047" style_bg_color="#phosphor" style_bg_opa="70%" />
		<hand name="hand_min" w="3" h="180" pivot_x="1" pivot_y="170" offset="-80" angle="570" style_bg_color="#phosphor" style_bg_opa="70%" />
		<hand name="hand_sec" w="3" h="216" pivot_x="1" pivot_y="214" offset="-106" angle="1800" style_bg_color="0xB8FFD8">
			<bind_flag_if_eq subject="subject_show_seconds" flag="hidden" ref_value="0" />
		</hand>
		<box width="10" height="10" align="center" clickable="false" style_radius="#radius_round" style_bg_color="0xB8FFD8" style_bg_opa="100%" />
	</view>
</component>
