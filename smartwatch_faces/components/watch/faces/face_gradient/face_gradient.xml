<component>
	<!-- Gradient: a purple-to-coral sky, big digital time, the date and the
	     weather. -->
	<styles>
		<style name="style_sky" bg_color="0x5B12C9" bg_grad_color="0xFF6F61" bg_grad_dir="ver" />
		<style name="style_digits" text_font="font_watch_digits_lg" text_color="0xFFFFFF" />
		<style name="style_soft" text_font="font_watch_body" text_color="0xFFFFFF" text_opa="80%" />
	</styles>

	<!-- Decoration only: nothing inside a face is clickable, so presses reach
	     whatever holds the face (face_stack, face_slot, ...). -->
	<view extends="box" scrollable="false" clickable="false">
		<style name="style_face" />
		<style name="style_sky" />

		<row align="center" y="-96" gap="8" clickable="false">
			<bind_flag_if_eq subject="subject_show_date" flag="hidden" ref_value="0" />
			<lv_label bind_text="subject_weekday">
				<style name="style_soft" />
			</lv_label>
			<lv_label bind_text="subject_day" bind_text-fmt="%d">
				<style name="style_soft" />
			</lv_label>
			<lv_label bind_text="subject_month">
				<style name="style_soft" />
			</lv_label>
		</row>

		<row align="center" y="-6" vertical_align="center" clickable="false">
			<lv_label bind_text="subject_hour" bind_text-fmt="%02d">
				<style name="style_digits" />
			</lv_label>
			<lv_label text=":" style_text_opa="60%">
				<style name="style_digits" />
			</lv_label>
			<lv_label bind_text="subject_minute" bind_text-fmt="%02d">
				<style name="style_digits" />
			</lv_label>
		</row>

		<row align="center" y="96" gap="10" vertical_align="center" clickable="false">
			<icon src="icon_cloud_sun_24" color="0xFFFFFF" />
			<lv_label bind_text="subject_temp" bind_text-fmt="%d°  Partly cloudy">
				<style name="style_soft" />
			</lv_label>
		</row>
	</view>
</component>
