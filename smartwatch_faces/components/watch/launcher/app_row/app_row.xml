<component>
	<previews>
		<preview name="default" width="340" height="110" style_bg_color="0x000000" />
	</previews>

	<api>
		<prop name="id" type="string" default="heart" help="App id passed to watch_nav_open_app()" />
		<prop name="icon_name" type="string" default="app_icon_heart" help="Name of the icon object, always app_icon_ + id (origin of the phase 2 reveal)" />
		<prop name="title" type="string" default="Heart rate" help="App name" />
		<prop name="icon" type="image" default="icon_heart_48" help="48 px app icon" />
		<prop name="color" type="color" default="#color_heart" help="Icon disc color" />
	</api>

	<styles>
		<style name="style_app_row" width="320" />
		<style name="style_app_icon" width="84" height="84" radius="#radius_round" bg_opa="100%" />
		<style name="style_app_icon_pressed" bg_opa="70%" />
	</styles>

	<!-- Launcher entry: a round, colored app icon and the app name. Only
	     the icon is interactive; the C handler takes it as the origin. -->
	<view extends="row" gap="20" vertical_align="center" clickable="false">
		<style name="style_app_row" />
		<box name="$icon_name" style_bg_color="$color">
			<style name="style_app_icon" />
			<style name="style_app_icon_pressed" selector="pressed" />
			<icon src="$icon" align="center" />
			<event_cb callback="watch_on_app_open" trigger="clicked" user_data="$id" />
		</box>
		<lv_label text="$title">
			<style name="style_title" />
		</lv_label>
	</view>
</component>
