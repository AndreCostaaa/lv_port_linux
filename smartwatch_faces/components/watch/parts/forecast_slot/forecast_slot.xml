<component>
	<previews>
		<preview name="default" width="80" height="100" style_bg_color="0x000000" />
	</previews>

	<api>
		<prop name="time" type="string" default="12" help="Hour label, e.g. 14" />
		<prop name="icon" type="image" default="icon_sun_24" help="24 px weather icon" />
		<prop name="temp" type="string" default="21°" help="Forecast temperature" />
	</api>

	<!-- One hour of the hourly forecast strip: hour, icon, temperature -->
	<view extends="column" width="60" gap="4" horizontal_align="center">
		<lv_label text="$time">
			<style name="style_caption" />
		</lv_label>
		<icon src="$icon" color="#color_weather" />
		<lv_label text="$temp" style_text_font="font_watch_caption" />
	</view>
</component>
