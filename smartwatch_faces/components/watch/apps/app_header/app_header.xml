<component>
	<previews>
		<preview name="default" width="240" height="50" style_bg_color="0x000000" />
	</previews>

	<api>
		<prop name="icon" type="image" default="icon_heart_24" help="24 px app icon" />
		<prop name="color" type="color" default="#color_heart" help="Icon color" />
		<prop name="title" type="string" default="Heart rate" help="App name" />
	</api>

	<!-- Small app title at the top of an app screen -->
	<view extends="row" gap="8" vertical_align="center" align="top_mid" y="30" clickable="false">
		<icon src="$icon" color="$color" />
		<lv_label text="$title" style_text_font="font_watch_caption" />
	</view>
</component>
