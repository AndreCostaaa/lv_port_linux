<component>
	<previews>
		<preview name="default" width="300" height="466" style_bg_color="0x000000" />
	</previews>

	<!-- Picker card for face_modular: a live face instance scaled into the
	     round face_slot. Tap selects the face, long-press removes it. -->
	<view extends="face_card_base" face_index="11" title="Modular">
		<box name="face_slot" align="center" scrollable="false">
			<style name="style_face_slot" />
			<event_cb callback="watch_on_face_select" trigger="clicked" user_data="11" />
			<event_cb callback="watch_on_face_delete" trigger="long_pressed" user_data="11" />
			<face_modular align="center">
				<style name="style_face_thumb" />
			</face_modular>
		</box>
	</view>
</component>
